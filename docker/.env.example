N_KB_MCP_ENABLED=true
N_KB_MCP_PATH=/mcp
N_KB_MCP_NAME=N-KB MCP
N_KB_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,nkb.localhost,nkb.localhost:*,n-kb,n-kb:*
N_KB_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*,http://nkb.localhost,http://nkb.localhost:*,http://n-kb,http://n-kb:*

# 可选：复用宿主机已有的 Qdrant 数据目录和 Ollama 模型目录，不设置时使用项目内 locals/ 下的相对路径
# N_KB_QDRANT_STORAGE_DIR=/absolute/path/to/qdrant/storage
# N_KB_OLLAMA_HOME=/absolute/path/to/ollama

# 观测配置：以下十二项默认值与 app/config.py 的 Settings 一致，取消注释即覆盖默认值。
# 部署说明：cp docker/.env.example docker/.env 后修改，再用 --env-file docker/.env 启动；
# .env 中的值只有通过 docker-compose 的 environment 映射传入容器才会生效，仅写 .env 不等于传入容器。
# 普通部署不开启观测，保持默认即可；接入 N-Agent 观测栈时由 Compose 顶层 include 自动加载 docker/observability/compose.yml。
# N_KB_OTEL_ENABLED=false
# N_KB_OTEL_EXPORTER_OTLP_ENDPOINT=
# N_KB_OTEL_TRACES_SAMPLE_RATIO=1.0
# N_KB_OTEL_CONTENT_MAX_BYTES=1024000
# N_KB_OTEL_GRAFANA_BASE_URL=
# N_KB_OTEL_GRAFANA_TRACES_BASE_URL=
# N_KB_OTEL_GRAFANA_METRICS_BASE_URL=
# N_KB_OTEL_GRAFANA_LOGS_BASE_URL=
# N_KB_OTEL_GRAFANA_PROFILE_BASE_URL=
# base_url 填浏览器可访问的 Grafana 根地址（支持子路径），自动派生 N-KB 大盘和 Explore。
# 三项显式外链优先；Profile 仅按服务查询。
# N_KB_PROFILING_ENABLED=false
# N_KB_PROFILING_PYROSCOPE_ENDPOINT=
# N_KB_PROFILING_INTERVAL_SECONDS=60

# 可选：观测 override 的 external 网络真实名称，默认 n-telemetry
# （N-Agent 观测栈 n-observability 的 otel-collector/pyroscope 所在接入网络，
# external 网络需已存在；一般无需覆盖）。
# N_KB_OBS_EXTERNAL_NETWORK=n-telemetry
