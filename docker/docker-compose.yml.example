name: n-kb

# Docker Compose 配置样例。
# 使用方式：cp docker/docker-compose.yml.example docker/docker-compose.yml，按本地环境调整后执行 bash docker/restart.sh。
# docker/docker-compose.yml 已被 .gitignore 忽略，本地个人路径不要提交。
# 宿主机挂载目录可通过 docker/.env 覆盖，默认值均为项目内相对路径。

services:
  n-kb:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    ports:
      - "8212:8212"
    environment:
      N_KB_SQLITE_PATH: /app/locals/n-kb.db
      N_KB_STORAGE_ROOT: /app/data
      N_KB_QDRANT_URL: http://qdrant:6333
      N_KB_QDRANT_COLLECTION: n_kb_documents
      N_KB_EMBEDDING_BASE_URL: http://ollama:11434
      N_KB_EMBEDDING_MODEL: bge-m3
      N_KB_INGESTION_BATCH_SIZE: "16"
      N_KB_MAX_UPLOAD_BYTES: "2097152"
      N_KB_ALLOWED_FILE_EXTENSIONS: .md,.txt
      N_KB_MCP_ENABLED: ${N_KB_MCP_ENABLED:-false}
      N_KB_MCP_PATH: ${N_KB_MCP_PATH:-/mcp}
      N_KB_MCP_NAME: ${N_KB_MCP_NAME:-N-KB MCP}
      N_KB_MCP_ALLOWED_HOSTS: ${N_KB_MCP_ALLOWED_HOSTS:-127.0.0.1:*,localhost:*,[::1]:*,nkb.localhost,nkb.localhost:*,n-kb,n-kb:*}
      N_KB_MCP_ALLOWED_ORIGINS: ${N_KB_MCP_ALLOWED_ORIGINS:-http://127.0.0.1:*,http://localhost:*,http://[::1]:*,http://nkb.localhost,http://nkb.localhost:*,http://n-kb,http://n-kb:*}
    volumes:
      - ../locals:/app/locals
      - ../data:/app/data
    depends_on:
      qdrant:
        condition: service_started
      ollama:
        condition: service_started
      ollama-pull-bge-m3:
        condition: service_completed_successfully

  qdrant:
    image: qdrant/qdrant:v1.18.2@sha256:75eab8c4ba42096724fdcfde8b4de0b5713d529dde32f285a1f86fdcb2c9e50c
    ports:
      - "6333:6333"
    volumes:
      # 复用已有 Qdrant 数据目录时，在 docker/.env 设置 N_KB_QDRANT_STORAGE_DIR 指向宿主机绝对路径。
      - ${N_KB_QDRANT_STORAGE_DIR:-../locals/qdrant/storage}:/qdrant/storage

  ollama:
    image: ollama/ollama@sha256:46399ef084d97b381955b5dc585c5d836dbe7ed3f79f170d1c04660fed511e3a
    ports:
      - "11434:11434"
    volumes:
      # 复用已有 Ollama 模型目录时，在 docker/.env 设置 N_KB_OLLAMA_HOME 指向宿主机绝对路径，避免重复下载模型。
      - ${N_KB_OLLAMA_HOME:-../locals/ollama}:/root/.ollama

  ollama-pull-bge-m3:
    image: ollama/ollama@sha256:46399ef084d97b381955b5dc585c5d836dbe7ed3f79f170d1c04660fed511e3a
    environment:
      OLLAMA_HOST: http://ollama:11434
    depends_on:
      - ollama
    entrypoint:
      - /bin/sh
    command:
      - -c
      - |
        until ollama list >/dev/null 2>&1; do
          echo "waiting for http://ollama:11434/api/tags"
          sleep 2
        done
        ollama pull bge-m3
